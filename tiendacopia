        function csvToArray(text) {
            const result = [];
            let row = [];
            let current = '';
            let inQuotes = false;
            text = text.replace(/\r\n/g, '\n');
            for (let i = 0; i < text.length; i++) {
                const char = text[i];
                const nextChar = text[i + 1];

                if (char === '"' && inQuotes && nextChar === '"') {
                    current += '"';
                    i++;
                } else if (char === '"') {
                    inQuotes = !inQuotes;
                } else if (char === ',' && !inQuotes) {
                    row.push(current);
                    current = '';
                } else if (char === '\n' && !inQuotes) {
                    row.push(current);
                    result.push(row);
                    row = [];
                    current = '';
                } else {
                    current += char;
                }
            }
            row.push(current);
            result.push(row);
            return result;
        }

        async function loadProducts() {
            const productGrid = document.getElementById('product-grid');
            if (!productGrid) return;

            const sheetUrl = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vSK0OrQot2ujjcN5zQ8RH4R-AEseAUnTnRMGknBUBLtXv0gAbb6rEFBmDtlSejS_C9L2w04oppTWGv5/pub?gid=23655206&single=true&output=csv';
            const proxyUrl = 'https://corsproxy.io/?';

            try {
                const response = await fetch(proxyUrl + encodeURIComponent(sheetUrl));
                if (!response.ok) throw new Error(`Error de red: ${response.statusText}`);
                const csvText = await response.text();
                if (!csvText) throw new Error('No se pudo obtener el contenido CSV.');
                
                const productsArray = csvToArray(csvText);
                productsArray.shift();

                if (productsArray.length === 0) {
                    productGrid.innerHTML = '<p class="col-span-full text-center text-gray-500">No hay productos para mostrar.</p>';
                    return;
                }

                let productsHTML = '';
                for (const columns of productsArray) {
                    if (columns.length < 9) continue;

                    const name = columns[1] ? columns[1].trim() : '';
                    const price = columns[2] ? columns[2].trim() : '';
                    const imageUrl = columns[8] ? columns[8].trim() : 'https://placehold.co/300x300/ffffff/2c3e50?text=Sin+Imagen';

                    if (!name || !price) continue;

                    productsHTML += `
                        <div class="bg-white rounded-lg shadow-md overflow-hidden product-card flex flex-col">
                            <a href="#"><img src="${imageUrl}" alt="${name}" class="w-full aspect-square object-cover" onerror="this.onerror=null;this.src='https://placehold.co/300x300/ffffff/2c3e50?text=Error+Img';"></a>
                            <div class="p-4 flex flex-col flex-grow">
                                <h3 class="text-sm font-semibold text-gray-800 flex-grow product-title" title="${name}">${name}</h3>
                                <p class="text-lg font-bold text-gray-900 mt-2">Bs. ${price}</p>
                                <button class="w-full mt-4 bg-accent text-white py-2 rounded-lg text-sm font-semibold hover-bg-accent-dark transition-colors">Añadir al carrito</button>
                            </div>
                        </div>`;
                }

                productGrid.innerHTML = productsHTML || '<p class="col-span-full text-center text-gray-500">No se encontraron productos válidos.</p>';

            } catch (error) {
                console.error('Error al cargar los productos:', error);
                productGrid.innerHTML = `<p class="col-span-full text-center text-red-500"><strong>Error:</strong> No se pudieron cargar los productos. <br><span class="text-sm text-gray-600">${error.message}</span></p>`;
            }
        }
        document.addEventListener('DOMContentLoaded', loadProducts);
    </script>
</body>
</html>
